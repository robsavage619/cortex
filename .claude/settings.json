{
  "permissions": {
    "allow": [
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_search",
      "Bash(curl -s *)",
      "Bash(uv run ruff check *)",
      "Bash(pdftotext *)"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "command -v uv >/dev/null || exit 0; uv run --no-sync ruff check --no-cache . 1>&2 || exit 2" }
        ]
      }
    ]
  }
}
