{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5175"],
      "port": 5175,
      "cwd": "web"
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "cortex", "serve", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": ["CORTEX_AUTH_USERS=dev:dev", "uv", "run", "cortex", "serve", "--port", "8321"],
      "port": 8321
    }
  ]
}
